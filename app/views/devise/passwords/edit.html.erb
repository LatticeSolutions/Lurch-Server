<% content_for :title, "Change your password" %>

<h1 class="font-bold text-4xl mb-6">Change your password</h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "contents" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="my-5">
    <%= f.label :password, "New password" %>
    <% if @minimum_password_length %>
      <p class="text-sm text-gray-500 mt-1"><%= @minimum_password_length %> characters minimum</p>
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full border-gray-400 focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= f.label :password_confirmation, "Confirm new password" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full border-gray-400 focus:outline-blue-600" %>
  </div>

  <div class="inline">
    <%= f.submit "Change my password", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
