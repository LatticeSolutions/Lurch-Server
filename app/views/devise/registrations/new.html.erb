<% content_for :title, "Sign up" %>

<h1 class="font-bold text-4xl mb-6">Sign up</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "contents" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="my-5">
    <%= f.label :email %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full border-gray-400 focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= f.label :password %>
    <% if @minimum_password_length %>
      <p class="text-sm text-gray-500 mt-1"><%= @minimum_password_length %> characters minimum</p>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password", class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full border-gray-400 focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= f.label :password_confirmation %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full border-gray-400 focus:outline-blue-600" %>
  </div>

  <div class="inline">
    <%= f.submit "Sign up", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
