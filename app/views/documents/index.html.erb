<% content_for :title, "Documents" %>

  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Documents</h1>
    <%= link_to "New document", new_document_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="documents" class="min-w-full divide-y divide-gray-200 space-y-5 my-4">
    <% if @documents.any? %>
      <ul class="list-disc ml-6">
      <% @documents.each do |document| %>
        <li>
          <%= document.title %>
          <%= link_to "View", document, class: "text-sky-600 hover:underline mx-4" %>
          <%= button_to "Destroy", document, method: :delete, class: "text-red-600 hover:underline cursor-pointer", form_class: "inline-block", data: { turbo_confirm: "Are you sure?" } %>
        </li>
      <% end %>
      </ul>
    <% else %>
      <p class="text-center my-10">No documents found.</p>
    <% end %>
  </div>
