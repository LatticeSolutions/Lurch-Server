<% content_for :title, "Documents" %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Documents</h1>
    <%= link_to "New document", new_document_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="documents" class="min-w-full divide-y divide-gray-200 space-y-5 my-4">
    <% if @documents.any? %>
      <ul class="list-disc ml-6">
      <% @documents.order(:title).each do |document| %>
        <li>
          <%= document.title %>
          <% if document.user != current_user %>
            <span class="text-sm text-sky-800 rounded-sm px-1 bg-sky-200"><%= document.user.email %></span>
          <% end %>
          <% if document.published? %>
            <span class="text-sm text-green-600 rounded-sm px-1 bg-green-100">Published</span>
          <% end %>
          <%= link_to "View", document, class: "text-sky-600 hover:underline ml-2", data: { turbo: false } %>
          <% if can? :edit, document %>
            <%= link_to "Edit", edit_document_path(document), class: "text-sky-600 hover:underline ml-2", data: { turbo: false } %>
          <% end %>
          <% if can? :publish, document %>
            <% if document.published? %>
              <%= button_to "Unpublish", unpublish_document_path(document), method: :patch, class: "text-sky-600 hover:underline cursor-pointer ml-2", form_class: "inline-block" %>
            <% else %>
              <%= button_to "Publish", publish_document_path(document), method: :patch, class: "text-sky-600 hover:underline cursor-pointer ml-2", form_class: "inline-block" %>
            <% end %>
          <% end %>
          <% if can? :duplicate, document %>
            <%= button_to "Duplicate", duplicate_document_path(document), method: :post, class: "text-sky-600 hover:underline cursor-pointer ml-2", form_class: "inline-block" %>
          <% end %>
          <% if can? :destroy, document and !document.published? %>
            <%= button_to "Destroy", document, method: :delete, class: "text-red-600 hover:underline cursor-pointer ml-2", form_class: "inline-block", data: { turbo_confirm: "Are you sure?" } %>
          <% end %>
        </li>
      <% end %>
      </ul>
    <% else %>
      <p class="text-center my-10">No documents found.</p>
    <% end %>
  </div>
