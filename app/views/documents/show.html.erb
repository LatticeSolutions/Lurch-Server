<% content_for :title, @document.title %>

<link rel="stylesheet" href="/lurchmath/main-app-styles.css">

<h1 class="my-5 text-xl font-thin">
  <%= @document.title %>
  <% if @document.user != current_user %>
    <span class="text-lg text-gray-600">(<%= @document.user.email %>)</span>
  <% end %>
  <% if @document.published? %>
    <span class="text-lg text-gray-600">(Public)</span>
  <% end %>
</h1>
<div id="editor-container">Loading editor...</div>

<script type="module" src="/lurchmath/editor.js"></script>
<script type="module">
  import { LurchDocument } from "/lurchmath/lurch-document.js"
  import { Dialog, CheckBoxItem, AlertItem } from "/lurchmath/dialog.js"
  import { getHeader, setHeader } from "/lurchmath/header-editor.js"
  import { Dependency } from "/lurchmath/dependencies.js"
  import { Atom } from "/lurchmath/atoms.js"

  const documentId = <%= @document.id.to_json.html_safe %>
  const documentTitle = <%= @document.title.to_json.html_safe %>
  // Only the document's owner or an admin may mutate it (including its
  // header/context) -- everyone else, e.g. a viewer of a published document
  // they don't own, gets a read-only editor. This mirrors the server-side
  // Ability rules in app/models/ability.rb.
  const canEdit = <%= (current_user.admin? || @document.user == current_user).to_json %>

  const csrfToken = () =>
    document.querySelector( 'meta[name="csrf-token"]' ).content

  // Same logic as the private ensureWorkIsSaved() in lurchmath/file-system.js,
  // reused here since it isn't exported for us to import directly.
  const ensureWorkIsSaved = editor => editor.isDirty()
    ? Dialog.areYouSure( editor, 'You will lose any unsaved work.  Continue anyway?' )
    : Promise.resolve( true )

  window.addEventListener( "load", () => {
    Lurch.createApp( document.getElementById( "editor-container" ), {
      appRoot : "/lurchmath",
      preventLeaving : false,
      autoSaveEnabled : false,
      // editor.js unconditionally appends to menuData.help.items, which is
      // only initialized if at least one help page is supplied.
      helpPages : [ { title : "Getting Started", url : "https://about.lurch.plus/getting-started" } ],
      // Always show the "meaning" (boxed) view of environments, rather than
      // the vendor default "minimal" presentation view.
      appDefaults : { 'default shell style' : 'boxed' },
      documentDefaults : { 'shell style' : 'boxed' },
      // Add the "validate" button (a green checkmark, already wired to the
      // same handler as the Document menu's "Show/Hide validity" item) to
      // the stock toolbar.
      toolbarData : 'undo redo | '
        + 'styles bold italic | '
        + 'alignleft aligncenter alignright outdent indent | '
        + 'numlist bullist | '
        + 'validate',
      menuData : {
        // Trim the stock File menu (which otherwise includes Save As, Delete
        // a document, Embed document, and Export LaTeX) down to just the
        // items wired to this app's own Rails actions, plus Print.
        file : {
          title : 'File',
          items : 'newlurchdocument opendocument savedocument duplicatedocument | print | closedocument'
        },
        // Drop "Show/Hide meaning" since meaning is always shown now.
        // "Add or remove context" (editdependencyurls, overridden below to pick
        // from this app's public documents) is only offered to users who can
        // actually save changes to this document.
        document : {
          title : 'Document',
          items : 'viewcontext'
            + ( canEdit ? ' editdependencyurls' : '' )
            + ' validate | docsettings'
        }
      }
    } ).then( editor => {
      editor.on( "init", () => {
        new LurchDocument( editor ).setDocument( <%= @document.content.to_json.html_safe %> )
        if ( !canEdit ) editor.mode.set( 'readonly' )
      } )

      // Replace the file-system-backed New/Open/Save menu items (which target
      // browser storage/Dropbox/a generic web URL) with actions against this
      // app's own documents.
      editor.ui.registry.addMenuItem( 'newlurchdocument', {
        text : 'New',
        icon : 'new-document',
        tooltip : 'New document',
        shortcut : 'Alt+N',
        onAction : () => ensureWorkIsSaved( editor ).then( ok => {
          if ( ok ) window.location.href = '/documents/new'
        } )
      } )
      editor.ui.registry.addMenuItem( 'opendocument', {
        text : 'Open',
        tooltip : 'Open document',
        shortcut : 'Alt+O',
        onAction : () => ensureWorkIsSaved( editor ).then( ok => {
          if ( ok ) window.location.href = '/documents'
        } )
      } )
      editor.ui.registry.addMenuItem( 'savedocument', {
        text : 'Save',
        tooltip : 'Save document',
        shortcut : 'Alt+S',
        onAction : () => {
          const content = new LurchDocument( editor ).getDocument( '' )
          fetch( `/documents/${documentId}.json`, {
            method : 'PATCH',
            headers : {
              'Content-Type' : 'application/json',
              'Accept' : 'application/json',
              'X-CSRF-Token' : csrfToken()
            },
            body : JSON.stringify( { document : { content } } )
          } ).then( response => {
            if ( !response.ok ) throw new Error( response.statusText )
            editor.setDirty( false )
            Dialog.notify( editor, 'success', 'Document saved.' )
          } ).catch( error => {
            Dialog.notify( editor, 'error', 'Could not save the document.' )
            console.error( error )
          } )
        }
      } )
      editor.ui.registry.addMenuItem( 'duplicatedocument', {
        text : 'Duplicate',
        icon : 'duplicate',
        tooltip : 'Save a copy as a new document',
        onAction : () => {
          const content = new LurchDocument( editor ).getDocument( '' )
          fetch( '/documents.json', {
            method : 'POST',
            headers : {
              'Content-Type' : 'application/json',
              'Accept' : 'application/json',
              'X-CSRF-Token' : csrfToken()
            },
            body : JSON.stringify( { document : { title : `Copy of ${documentTitle}`, content } } )
          } ).then( response => {
            if ( !response.ok ) throw new Error( response.statusText )
            return response.json()
          } ).then( created => {
            window.location.href = `/documents/${created.id}`
          } ).catch( error => {
            Dialog.notify( editor, 'error', 'Could not duplicate the document.' )
            console.error( error )
          } )
        }
      } )
      editor.ui.registry.addMenuItem( 'closedocument', {
        text : 'Close',
        icon : 'close',
        tooltip : 'Close this document and return to the homepage',
        onAction : () => ensureWorkIsSaved( editor ).then( ok => {
          if ( ok ) window.location.href = '/documents'
        } )
      } )

      // Replace the vendor's "Add or remove context" dialog (which offers
      // file-system/upload/URL-based dependencies) with one that only offers
      // this app's own public documents as context.
      if ( canEdit ) {
        editor.ui.registry.addMenuItem( 'editdependencyurls', {
          text : 'Add or remove context',
          tooltip : 'Choose which public documents this one depends on',
          icon : 'edit-block',
          onAction : () => {
            const header = getHeader( editor )
            const alreadyAttached = header
              ? Dependency.topLevelDependenciesIn( header, editor )
                  .map( atom => atom.getMetadata( 'sourceDocumentId' ) )
              : [ ]
            fetch( '/documents/public.json', {
              headers : { 'Accept' : 'application/json' }
            } ).then( response => {
              if ( !response.ok ) throw new Error( response.statusText )
              return response.json()
            } ).then( publicDocuments => {
              const dialog = new Dialog( 'Add or remove context', editor )
              dialog.json.size = 'medium'
              if ( publicDocuments.length == 0 ) {
                dialog.addItem( new AlertItem( 'warn',
                  'No public documents are available yet.' ) )
              } else {
                publicDocuments.forEach( doc => dialog.addItem(
                  new CheckBoxItem( doc.id, `${doc.title} (${doc.owner})` ) ) )
                dialog.setInitialData( Object.fromEntries( publicDocuments.map(
                  doc => [ doc.id, alreadyAttached.includes( doc.id ) ] ) ) )
              }
              dialog.show().then( userHitOK => {
                if ( !userHitOK ) return
                const selectedIds = publicDocuments.filter(
                  doc => dialog.get( doc.id ) ).map( doc => doc.id )
                // Remove any context panel that may have been shown; it's now
                // out of date and will be rebuilt the next time it's opened.
                editor.getBody().querySelector( '#context' )?.remove()
                Promise.all( selectedIds.map( id =>
                  fetch( `/documents/${id}.json`, {
                    headers : { 'Accept' : 'application/json' }
                  } ).then( response => response.json() )
                ) ).then( selectedDocuments => {
                  let newHeader = getHeader( editor )
                  if ( !newHeader ) {
                    setHeader( editor, '' )
                    newHeader = getHeader( editor )
                  }
                  // (NOTE: newHeader is a CLONE, so edits here don't affect the
                  // real document header until we call setHeader() below.)
                  Dependency.topLevelDependenciesIn( newHeader, editor ).forEach(
                    atom => atom.element.remove() )
                  selectedDocuments.forEach( doc => {
                    const dependency = Atom.newBlock( editor, '', {
                      type : 'dependency',
                      description : 'none',
                      filename : doc.title,
                      source : 'Public Documents',
                      autoRefresh : false,
                      sourceDocumentId : doc.id
                    } )
                    dependency.setHTMLMetadata( 'content', doc.content )
                    dependency.update()
                    newHeader.appendChild( dependency.element )
                  } )
                  setHeader( editor, newHeader.innerHTML )
                  Dialog.notify( editor, 'success', 'Updated this document’s context.' )
                } ).catch( error => {
                  Dialog.notify( editor, 'error', 'Could not update this document’s context.' )
                  console.error( error )
                } )
              } )
            } ).catch( error => {
              Dialog.notify( editor, 'error', 'Could not load public documents.' )
              console.error( error )
            } )
          }
        } )
      }
    } )
  } )
</script>
