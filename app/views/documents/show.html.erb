<% content_for :title, @document.title %>

<%= tag.div data: {
      controller: "document-view",
      document_view_context_value: @document.context_documents_tree,
      document_view_metadata_value: document_metadata_html(@document)
    } do %>
  <h1 class="my-5 text-xl font-thin">
    <%= @document.title %>
    <%# Shown once the view's validation finds every statement valid. %>
    <span data-document-view-target="checkmark" hidden class="text-green-600" title="All statements validate" aria-label="All statements validate">✓</span>
    <% if @document.user != current_user %>
      <span class="text-lg text-gray-600">(<%= @document.user.email %>)</span>
    <% end %>
    <% if @document.published? %>
      <span class="text-lg text-gray-600">(Public)</span>
    <% end %>
    <% if can? :edit, @document %>
      <%= link_to "Edit", edit_document_path(@document), class: "text-sm text-sky-600 hover:underline ml-2", data: { turbo: false } %>
    <% end %>
    <% if can? :duplicate, @document %>
      <%= button_to "Duplicate", duplicate_document_path(@document), method: :post, class: "text-sm text-sky-600 hover:underline cursor-pointer ml-2", form_class: "inline-block", form: { data: { turbo: false } } %>
    <% end %>
  </h1>

  <% if @document.context_documents.any? %>
    <p class="mb-3 text-sm">
      Context:
      <%= safe_join @document.context_documents.map { |doc| link_to doc.title, doc, class: "text-sky-600 hover:underline" }, ", " %>
    </p>
  <% end %>

  <%# Rendered in a sandboxed iframe (no allow-scripts) so the Lurch content
      stylesheets don't leak into this page; see DocumentsHelper. %>
  <%= tag.iframe srcdoc: document_view_srcdoc(@document),
        sandbox: "allow-same-origin allow-popups allow-popups-to-escape-sandbox",
        title: @document.title,
        class: "w-full bg-white rounded border-0 mb-4",
        data: { document_view_target: "frame" } %>

  <%# Read-only source and output of a clicked math atom, like the editor's
      "View math" dialog; filled in by the document-view controller. %>
  <dialog data-document-view-target="mathDialog"
          data-action="click->document-view#closeMathDialogOnBackdrop"
          class="m-auto w-full max-w-xl rounded-lg p-0 shadow-xl backdrop:bg-black/40">
    <div class="p-4">
      <h2 data-document-view-target="mathDialogTitle" class="mb-3 text-lg font-thin"></h2>
      <textarea data-document-view-target="mathSource" readonly rows="1"
                aria-label="Source"
                class="w-full resize-none rounded border border-gray-300 bg-gray-50 p-2 font-mono text-sm"></textarea>
      <div data-document-view-target="mathPreview" class="mt-2 text-xl"></div>
      <div class="mt-4 flex items-center justify-between text-sm text-gray-500">
        <span><kbd class="rounded border border-gray-300 px-1">Esc</kbd> close</span>
        <button type="button" data-action="document-view#closeMathDialog"
                class="cursor-pointer text-sky-600 hover:underline">Close</button>
      </div>
    </div>
  </dialog>
<% end %>
