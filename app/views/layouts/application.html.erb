
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Lurch Server" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Lurch Server">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="m-0 text-gray-700 font-sans min-h-screen bg-[linear-gradient(45deg,darkslategrey,transparent)]">
    <header class="sticky top-0 z-50 flex items-center justify-between gap-6 border-b border-topbar-border bg-topbar-bg px-6 py-3 bg-white">
      <%= link_to :root, class: "flex items-center", aria_label: "Lurch Plus home" do %>
        <%= image_tag "lurchlogo.png", alt: "Lurch Plus", class: "h-9 w-auto" %>
      <% end %>
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium" aria-label="Landing page navigation">
        <a class="text-gray-600 hover:text-accent" href="https://about.lurch.plus/getting-started">Get Started</a>
        <a class="text-gray-600 hover:text-accent" href="https://about.lurch.plus/resources/">Resources</a>
        <%= link_to "Documents", documents_path, class: "text-gray-600 hover:text-accent" %>
      </nav>
    </header>
    <main>
      <% if content_for? :full_page_content %>
        <div class="bg-white">
          <%= yield(:full_page_content) %>
        </div>
      <% else %>
        <div class="bg-white max-w-5xl p-4 m-auto">
          <% if notice %>
            <p class="cursor-pointer bg-green-50 text-green-800 px-4 py-2 text-sm" onclick="this.remove()"><%= notice %></p>
          <% end %>
          <% if alert %>
            <p class="cursor-pointer bg-red-50 text-red-800 px-4 py-2 text-sm" onclick="this.remove()"><%= alert %></p>
          <% end %>
          <%= yield %>
        </div>
      <% end %>
    </main>
    <% if content_for? :footer %>
      <%= yield(:footer) %>
    <% end %>
  </body>
</html>
